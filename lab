void zadanie2(void)
{
    int N = 14, K = 30;
    int minuts = N * 60 + K;
    int left = 24 * 60 - minuts;

    puts("=== Задание 2 ===");
    printf("Сейчас %d часов %d минут 00 секунд\n", N, K);
    printf("Идет %d минута суток\n", minuts);
    printf("До полуночи осталось %d часов и %d минут\n", left / 60, left % 60);
    printf("С 8.00 прошло %d секунд\n", (minuts - 8 * 60) * 60);
    printf("Текущий час = %.2f суток и текущая минута = %.2f часа\n", N / 24.0, K / 60.0);
    puts("");
}

