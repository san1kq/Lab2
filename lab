void homework(void)
{
    double distance = 390.0;
    double rolls = 15.0;
    double ford = 36.0;
    double x = 3.5;

    double costRolls = distance / rolls * x;
    double costFord = distance / ford * x;
    double saving = costRolls - costFord;

    puts("=== Домашнее задание === Вариант 9 ===");
    printf("Из Лондона в Эдинбург нужно проехать %.0f миль.\n", distance);
    printf("Роллс-Ройс расходует 1 галлон на %.0f миль, Форд-Эскорт - 1 галлон на %.0f миль.\n", rolls, ford);
    printf("При цене %.2f фунта за галлон поездка на Роллс-Ройсе обойдется в %.2f фунтов.\n", x, costRolls);
    printf("На Форд-Эскорте она обойдется в %.2f фунтов, то есть человек сэкономит %.2f фунтов.\n", costFord, saving);
    puts("");
}

